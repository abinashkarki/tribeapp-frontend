# Web3Forms Configuration
WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here
NEXT_PUBLIC_CONTACT_FORM_ENABLED=true

# Site Configuration  
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_TELEMETRY_DISABLED=1

# Instructions:
# 1. Copy this file to .env.local for development
# 2. Copy this file to .env.production for production deployment
# 3. Replace the placeholder values with your actual configuration
# 4. Never commit .env.local or .env.production to version control
